# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skill_tracker

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 服务配置
PORT=8000
HOST=0.0.0.0
DEBUG=True
RELOAD=True

# CORS配置
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=True

# 日志配置
LOG_LEVEL=INFO

# LLM配置（可选，后续使用）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_TEMPERATURE=0.7

# RAG配置（可选，后续使用）
VECTOR_DB_URL=
